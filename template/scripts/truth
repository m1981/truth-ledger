#!/usr/bin/env python3
"""truth v0.9.38 -- append-only claims ledger with a native work kernel.

Facts are appended as JSONL records to .truth/claims.jsonl (INV-A:
append-only, commit-gated by scripts/check-truth.sh); every status is
derived by a pure, confluent fold over the records in the total
(ts, id, canon) order (ADR-016), so union-merged branch ledgers reach
one state. Internals are FUNCTIONAL CORE / IMPERATIVE SHELL: decisions
and derivations are pure functions (no subprocess, filesystem, clock,
or env), unit-tested by scripts/test-truth-core.py; git, files,
evidence execution, argparse, and printing live at the edge,
acceptance-tested by scripts/truth-canary.sh (seeded faults, every one
must be caught). Event kinds, fold semantics, invariants: see
.truth/README.md and docs/adr/truth/.

Full version history: CHANGELOG.md (extracted from this docstring at
v0.9.13, roadmap-v3 R5). Line 2 above keeps the version self-statement
the ADR-026 lockstep test parses and pins all other surfaces to.

Stdlib only. Python 3.9+. POSIX (G5: documented limit).

Since v0.9.28 (ADR-044) this file is the THIN ENTRY over the truthlib/
package one directory up: it re-exports every module's namespace, so
`python3 scripts/truth <verb>` and every SourceFileLoader consumer see
the exact single-file surface they always did.
"""
import os
import sys

# ADR-044 bootstrap: resolve THIS file through any symlink (the meta-repo's
# root scripts/truth links here), then make the directory that contains
# truthlib/ importable -- the entry's parent's parent, so a copied tree
# (consumer repo, canary sandbox) resolves identically: <root>/scripts/truth
# beside <root>/truthlib/.
_PKG_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _PKG_ROOT not in sys.path:
    sys.path.insert(0, _PKG_ROOT)

from truthlib.registry import *
from truthlib.kernel import *
from truthlib.evidence import *
from truthlib.policy import *
from truthlib.reports import *
from truthlib.contract import *
from truthlib.shellio import *
from truthlib.gates import *
from truthlib.advisory import *
from truthlib.cli import *

# Underscore names the suites reach through this module (star imports skip
# them): SourceFileLoader("truth", "scripts/truth") is the one loading
# surface both test suites and the canary use, so EVERY name of the old
# single file stays importable from here.
from truthlib.kernel import _glob_rx, _ISSUE_EVENT_STATUS
from truthlib.evidence import _evidence_toks, _SCREEN_SEPARATORS, \
    _SCREEN_PUNCT
from truthlib.policy import _ttl_expired, _anchor_unreachable, \
    _evidence_paths_touched
from truthlib.advisory import _escape_ctrl
from truthlib.gates import _gate_text_nonempty, _gate_duplicate, \
    _gate_quantifier_scope, _gate_scope_decay, _gate_inv_m, \
    _gate_generated, _gate_class_precheck, _gate_evidence_exit, _gate_blast
from truthlib.shellio import _last_ledger_ts, _LAST_TS_TAIL_BYTES, _short_sha, \
    _OVERRIDES
from truthlib.cli import _issue_or_exit

# A3: the ADR-044 monkeypatch seam is GONE. It lived here -- a
# _MirrorModule whose __setattr__ pushed every assignment into all ten
# truthlib modules, and a _self_module() that located its own module
# object via gc.get_referrers() when neither sys.modules nor __main__
# held it. Its whole purpose was to let a test write
# `tm.ledger_path = ...` and have the three modules that star-import the
# name (gates, shellio, cli) observe it.
#
# ADR-044 was right to ship it: preserving 100% of the pre-split test
# corpus WAS the equivalence proof for the package split, and that proof
# has been delivered. What remained was metaclass surgery and a gc walk
# in the production loading path, for seven assignments of two names --
# and gc.get_referrers is exactly the kind of thing that breaks on a
# Python upgrade and produces a traceback nobody can read.
#
# The substitution point moved INSIDE the functions
# (truthlib.shellio.configure / reset_configuration), so every
# star-imported binding already refers to the one object that consults
# the override. Nothing needs mirroring, and an unknown name now raises
# instead of silently doing nothing.
#
# The three loading styles ADR-044 shipped as a contract are unaffected,
# because none of them depended on the mirror: as __main__, via
# SourceFileLoader(...).load_module(), and via spec/exec_module().

if __name__ == "__main__":
    main()
